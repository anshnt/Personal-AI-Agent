# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/personal_ai_agent

# API key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Identity
#
# A personal agent is single-tenant by default: every request resolves to this
# user, and the row is created on first use. The schema is already multi-user,
# so adding real auth means changing one function (resolveCurrentUser).
# ---------------------------------------------------------------------------

DEFAULT_USER_EMAIL=owner@localhost
DEFAULT_USER_NAME=
DEFAULT_USER_TIMEZONE=UTC

# ---------------------------------------------------------------------------
# Models (optional)
# ---------------------------------------------------------------------------

# Drives the interactive agent loop.
AGENT_MODEL=claude-opus-5

# Short structured background calls: memory extraction and conversation titling.
UTILITY_MODEL=claude-haiku-4-5

# Reasoning effort for the agent loop: low | medium | high | xhigh | max
AGENT_EFFORT=high

# Maximum tool-calling steps in a single turn.
MAX_AGENT_STEPS=24

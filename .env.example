# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/personal_ai_agent

# API key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Identity
#
# A personal agent is single-tenant by default: every request resolves to this
# user, and the row is created on first use. The schema is already multi-user,
# so adding real auth means changing one function (resolveCurrentUser).
# ---------------------------------------------------------------------------

DEFAULT_USER_EMAIL=owner@localhost
DEFAULT_USER_NAME=
DEFAULT_USER_TIMEZONE=UTC

# ---------------------------------------------------------------------------
# Local file access (optional, off by default)
#
# Set this to a directory and the agent gains list_files and read_file, scoped
# to that directory. Paths are resolved through symlinks and re-checked against
# the root, so nothing outside it is reachable. Leave it unset to keep the
# agent off your filesystem entirely.
# ---------------------------------------------------------------------------

# AGENT_FILES_DIR=/home/you/Documents/agent

# ---------------------------------------------------------------------------
# Mail (optional, off by default)
#
# MAIL_PROVIDER=imap reads a real mailbox. IMAP rather than a provider-specific
# API because one implementation covers Gmail, Outlook, Fastmail and
# self-hosted servers, with an app password instead of an OAuth consent flow.
#
# For Gmail: enable 2FA, create an app password at
# https://myaccount.google.com/apppasswords, and use IMAP_HOST=imap.gmail.com.
# The account password will not work.
#
# Credentials are read from here at connect time and never written to the
# database, so a database dump cannot be used to read your mail.
# ---------------------------------------------------------------------------

# MAIL_PROVIDER=imap
# MAIL_ADDRESS=you@gmail.com
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_USER=you@gmail.com
# IMAP_PASSWORD=

# MAIL_PROVIDER=local reads a directory of .eml files instead. Useful for an
# exported mailbox, and for trying the agent out without handing it credentials.
# MAIL_PROVIDER=local
# MAIL_LOCAL_DIR=/home/you/mail-export

# ---------------------------------------------------------------------------
# Web search (optional, off by default)
#
# Set any one of these and search turns on. SEARCH_PROVIDER forces a choice
# when more than one is configured.
# ---------------------------------------------------------------------------

# BRAVE_SEARCH_API_KEY=      # https://api-dashboard.search.brave.com/
# TAVILY_API_KEY=            # https://tavily.com/ - returns extracted page text
# SEARXNG_URL=               # a self-hosted instance, e.g. http://127.0.0.1:8888
# SEARCH_PROVIDER=brave      # brave | tavily | searxng

# Hosts allowed to bypass the private-address refusal on web_fetch.
#
# Outbound fetches normally refuse loopback, private, link-local and
# cloud-metadata addresses, because a URL the model chose must not be able to
# reach this machine or an instance credential endpoint. Add a host here only to
# reach something you run yourself, such as a SearXNG on loopback. Matching is
# exact on host or host:port, never a suffix.
# WEB_FETCH_ALLOW_HOSTS=127.0.0.1:8888

# ---------------------------------------------------------------------------
# Scheduling (optional, off by default)
#
# Set a secret and point any scheduler at the endpoint, roughly every minute:
#
#   * * * * * curl -fsS -X POST http://localhost:3000/api/cron \
#               -H "Authorization: Bearer $CRON_SECRET"
#
# Vercel Cron sends this secret as a bearer token automatically. Claiming is
# atomic, so overlapping pings and multiple instances are safe.
#
# Without CRON_SECRET the endpoint returns 503 rather than running unauthenticated:
# anyone who found the URL could otherwise make this app spend tokens on every
# scheduled agent run, as often as they liked.
# ---------------------------------------------------------------------------

# CRON_SECRET=

# ---------------------------------------------------------------------------
# External APIs
#
# Weather, geocoding and currency work with no configuration at all — those
# services need no key. GitHub needs a token.
# ---------------------------------------------------------------------------

# GITHUB_TOKEN=             # a fine-grained personal access token

# Add your own APIs without a code change. Same declarative shape as the
# built-ins: a fixed host, named operations, validated parameters, and the
# credential read from the environment rather than held by the model.
#
# CUSTOM_CONNECTORS='[{"name":"house","description":"Home automation.",
#   "baseUrl":"https://house.example.com",
#   "auth":{"kind":"header","envVar":"HOUSE_TOKEN","header":"X-Api-Key"},
#   "rateLimit":{"calls":30,"windowSeconds":600},
#   "operations":[{"name":"read_sensor","description":"Read a sensor.",
#     "method":"GET","path":"/sensors/{id}",
#     "params":{"id":{"required":true,"description":"Sensor id"}}}]}]'

# ---------------------------------------------------------------------------
# Models (optional)
# ---------------------------------------------------------------------------

# Drives the interactive agent loop.
AGENT_MODEL=claude-opus-5

# Short structured background calls: memory extraction and conversation titling.
UTILITY_MODEL=claude-haiku-4-5

# Reasoning effort for the agent loop: low | medium | high | xhigh | max
AGENT_EFFORT=high

# Maximum tool-calling steps in a single turn.
MAX_AGENT_STEPS=24

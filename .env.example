# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/personal_ai_agent

# API key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Identity
#
# A personal agent is single-tenant by default: every request resolves to this
# user, and the row is created on first use. The schema is already multi-user,
# so adding real auth means changing one function (resolveCurrentUser).
# ---------------------------------------------------------------------------

DEFAULT_USER_EMAIL=owner@localhost
DEFAULT_USER_NAME=
DEFAULT_USER_TIMEZONE=UTC

# ---------------------------------------------------------------------------
# Local file access (optional, off by default)
#
# Set this to a directory and the agent gains list_files and read_file, scoped
# to that directory. Paths are resolved through symlinks and re-checked against
# the root, so nothing outside it is reachable. Leave it unset to keep the
# agent off your filesystem entirely.
# ---------------------------------------------------------------------------

# AGENT_FILES_DIR=/home/you/Documents/agent

# ---------------------------------------------------------------------------
# Mail (optional, off by default)
#
# MAIL_PROVIDER=imap reads a real mailbox. IMAP rather than a provider-specific
# API because one implementation covers Gmail, Outlook, Fastmail and
# self-hosted servers, with an app password instead of an OAuth consent flow.
#
# For Gmail: enable 2FA, create an app password at
# https://myaccount.google.com/apppasswords, and use IMAP_HOST=imap.gmail.com.
# The account password will not work.
#
# Credentials are read from here at connect time and never written to the
# database, so a database dump cannot be used to read your mail.
# ---------------------------------------------------------------------------

# MAIL_PROVIDER=imap
# MAIL_ADDRESS=you@gmail.com
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_USER=you@gmail.com
# IMAP_PASSWORD=

# MAIL_PROVIDER=local reads a directory of .eml files instead. Useful for an
# exported mailbox, and for trying the agent out without handing it credentials.
# MAIL_PROVIDER=local
# MAIL_LOCAL_DIR=/home/you/mail-export

# ---------------------------------------------------------------------------
# Models (optional)
# ---------------------------------------------------------------------------

# Drives the interactive agent loop.
AGENT_MODEL=claude-opus-5

# Short structured background calls: memory extraction and conversation titling.
UTILITY_MODEL=claude-haiku-4-5

# Reasoning effort for the agent loop: low | medium | high | xhigh | max
AGENT_EFFORT=high

# Maximum tool-calling steps in a single turn.
MAX_AGENT_STEPS=24
